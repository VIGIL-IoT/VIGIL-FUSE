{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FUSE Optional Reasoning Output v1",
  "type": "object",
  "required": ["summary", "reasoning", "missing_evidence", "recommended_checks", "remediation", "limitations"],
  "properties": {
    "summary": { "type": "string" },
    "reasoning": { "type": "string" },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "value"],
        "properties": {
          "item": { "type": "string" },
          "value": { "enum": ["high", "medium", "low"] }
        },
        "additionalProperties": false
      }
    },
    "recommended_checks": { "type": "array", "items": { "type": "string" } },
    "remediation": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
