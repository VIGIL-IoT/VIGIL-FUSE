{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VIGIL-IoT/VIGIL-FUSE/blob/main/src/vigil_fuse/schemas/ghidra-benchmark.schema.json",
  "title": "FUSE controlled Ghidra adapter benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "generated_at_utc",
    "source_revision",
    "method",
    "environment",
    "input",
    "measurements",
    "result",
    "measurement_notes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "benchmark": { "const": "fuse-ghidra-controlled-input" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "working_tree_dirty"],
      "properties": {
        "commit": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "working_tree_dirty": { "type": ["boolean", "null"] }
      }
    },
    "method": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_release", "architecture", "python", "ghidra", "java"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "os_release": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "ghidra": { "const": "12.2" },
        "java": { "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "format", "byte_size", "sha256"],
      "properties": {
        "kind": { "const": "controlled local executable" },
        "format": { "enum": ["ELF", "PE", "Mach-O", "raw"] },
        "byte_size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_headless_startup_seconds",
        "ghidra_discovery_seconds",
        "headless_process_wall_seconds",
        "adapter_wall_seconds",
        "sample_interval_seconds",
        "sampled_process_tree_peak_rss_bytes",
        "sampled_process_tree_inaccessible_samples",
        "sampled_process_tree_sample_count",
        "artifact_bytes"
      ],
      "properties": {
        "cold_headless_startup_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "ghidra_discovery_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "headless_process_wall_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "adapter_wall_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "sample_interval_seconds": { "const": 0.02 },
        "sampled_process_tree_peak_rss_bytes": { "type": "integer", "minimum": 0 },
        "sampled_process_tree_inaccessible_samples": { "type": "integer", "minimum": 0 },
        "sampled_process_tree_sample_count": { "type": "integer", "minimum": 0 },
        "artifact_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "finding_count", "rule_ids"],
      "properties": {
        "status": {
          "enum": ["completed", "partial", "timeout", "failed", "unavailable", "incompatible", "unsupported"]
        },
        "finding_count": { "type": "integer", "minimum": 0 },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^FUSE-BIN-[0-9]{3}$" }
        }
      }
    },
    "measurement_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
