                "validationMethod": "static",
                "validationStatus": "not-validated",
                "category": "ci-workflow-security",
                "version": "1.0.0"
              },
              "helpUri": "https://docs.github.com/en/actions/security-for-github-actions/security-guides/security-hardening-for-github-actions#using-third-party-actions"
            },
            {
              "id": "FUSE003",
              "shortDescription": {
                "text": "TLS peer verification appears disabled"
              },
              "fullDescription": {
                "text": "The source contains an explicit setting or API commonly used to bypass TLS certificate or hostname verification. FUSE does not establish that this path runs."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "high",
