{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FUSE Scan Report 1.5",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "target",
    "scan",
    "summary",
    "coverage",
    "hardware_inventory",
    "project_context",
    "findings",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.5"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "FUSE"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "string"
    },
    "scan": {
      "type": "object",
      "required": [
        "target_kind",
        "profile",
        "network_policy",
        "started_at",
        "completed_at",
        "input_manifest_sha256"
      ],
      "properties": {
        "target_kind": {
          "enum": [
            "directory",
            "source-file",
            "unsupported-file",
            "firmware-image",
            "sbom"
          ]
        },
        "profile": {
          "type": "string"
        },
        "network_policy": {
          "enum": [
            "not-requested",
            "network-allowed",
            "offline-vulnerabilities",
            "no-network"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "files_discovered",
        "files_selected",
        "files_filtered",
        "files_scanned",
        "source_bytes_read",
        "files_skipped",
        "analysis_performed",
        "finding_count",
        "severity_counts"
      ],
      "properties": {
        "files_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "files_selected": {
          "type": "integer",
          "minimum": 0
        },
        "files_filtered": {
          "type": "integer",
          "minimum": 0
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "source_bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "analysis_performed": {
          "type": "boolean"
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "severity_counts": {
          "type": "object",
          "required": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "files_skipped_by_reason",
        "discovery_complete",
        "limits_reached",
        "support",
        "rules_available",
        "rules_enabled",
        "analyzers"
      ],
      "properties": {
        "files_skipped_by_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "discovery_complete": {
          "type": "boolean"
        },
        "limits_reached": {
          "type": "array",
          "items": {
            "enum": [
              "discovery-budget",
              "scan-time",
              "total-source-bytes"
            ]
          },
          "uniqueItems": true
        },
        "support": {
          "type": "object",
          "required": [
            "capability_id",
            "label",
            "status",
            "scope",
            "limitations"
          ],
          "properties": {
            "capability_id": {
              "type": "string"
            },
            "label": {
              "enum": [
                "detected",
                "basic",
                "supported",
                "partial",
                "experimental",
                "planned",
                "unsupported"
              ]
            },
            "status": {
              "enum": [
                "completed",
                "partial",
                "unavailable",
                "skipped",
                "failed",
                "detected",
                "unsupported"
              ]
            },
            "scope": {
              "type": "string"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "rules_available": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rules_enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "analyzers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "findings"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "completed",
                  "partial",
                  "unavailable",
                  "skipped",
                  "failed"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "findings": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "hardware_inventory": {
      "type": "object",
      "required": [
        "scope",
        "complete",
        "present",
        "file_count",
        "category_counts",
        "artifacts"
      ],
      "properties": {
        "scope": {
          "enum": [
            "directory",
            "single-file"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "present": {
          "type": "boolean"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "category_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "category",
              "format"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "format": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "project_context": {
      "type": "object",
      "required": [
        "framework",
        "status",
        "project_detected",
        "build_dir",
        "target",
        "board",
        "framework_version",
        "adapter_capability_id",
        "adapter_support_label",
        "evidence",
        "configuration_files",
        "settings",
        "limitations",
        "component_lock"
      ],
      "properties": {
        "framework": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "esp-idf",
            "zephyr",
            null
          ]
        },
        "status": {
          "enum": [
            "not-detected",
            "detected",
            "build-selected",
            "generated-config-found",
            "partial"
          ]
        },
        "project_detected": {
          "type": "boolean"
        },
        "build_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "board": {
          "type": [
            "string",
            "null"
          ]
        },
        "framework_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_capability_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter_support_label": {
          "enum": [
            "experimental",
            "planned"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configuration_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "role",
              "sha256",
              "byte_size"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "path",
              "line"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "enum": [
                  "enabled",
                  "disabled",
                  "unknown"
                ]
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component_lock": {
          "type": "object",
          "required": [
            "status",
            "path",
            "sha256",
            "byte_size",
            "lock_version",
            "target",
            "selected_target_match",
            "manifest_hash",
            "manifest_freshness",
            "direct_dependencies",
            "components",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-detected",
                "partial",
                "parser-unavailable",
                "invalid",
                "target-matches",
                "target-mismatch",
                "target-unverified"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 0
            },
            "lock_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "target": {
              "type": [
                "string",
                "null"
              ]
            },
            "selected_target_match": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "manifest_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "manifest_freshness": {
              "enum": [
                "unverified",
                "missing"
              ]
            },
            "direct_dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "version",
                  "source_type",
                  "direct",
                  "component_hash",
                  "compatible_targets",
                  "dependencies"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "source_type": {
                    "type": "string"
                  },
                  "direct": {
                    "type": "boolean"
                  },
                  "component_hash": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "compatible_targets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "media_type",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "fingerprint",
        "rule_id",
        "rule_version",
        "analyzer",
        "title",
        "severity",
        "confidence",
        "severity_basis",
        "severity_score",
        "severity_vector",
        "severity_version",
        "category",
        "location",
        "evidence",
        "explanation",
        "potential_impact",
        "remediation",
        "references",
        "applicability",
        "validation_method",
        "validation_status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rule_id": {
          "type": "string"
        },
        "rule_version": {
          "type": "string"
        },
        "analyzer": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "unknown"
          ]
        },
        "severity_basis": {
          "enum": [
            "rule",
            "upstream-label",
            "cvss-score",
            "cvss-vector",
            "unknown"
          ]
        },
        "severity_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "severity_vector": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "applicability": {
          "enum": [
            "unknown",
            "candidate",
            "applicable",
            "not_applicable"
          ]
        },
        "validation_method": {
          "enum": [
            "static",
            "generated-config",
            "advisory-match",
            "external-tool",
            "lab",
            "operator-guided"
          ]
        },
        "validation_status": {
          "enum": [
            "not-validated",
            "validated",
            "not-applicable"
          ]
        },
        "category": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "required": [
            "file",
            "start_line",
            "end_line"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "start_line": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "end_line": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "potential_impact": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
