{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FUSE labeled evaluation decisions, version 1.0",
  "type": "object",
  "required": ["schema_version", "dataset_id", "split", "scope", "ground_truth", "fuse_commit", "rules", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["regression", "benchmark", "controlled-binary", "independent-holdout"]},
    "scope": {"type": "string", "minLength": 1},
    "ground_truth": {"type": "string", "minLength": 1},
    "fuse_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "input_sha256", "expected", "observed", "status", "coverage"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "minLength": 1},
          "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "expected": {"enum": ["positive", "negative", "unknown", "uncertain", "not_applicable"]},
          "observed": {"type": ["boolean", "null"]},
          "status": {"enum": ["completed", "partial", "unsupported", "failed", "timeout", "not_run"]},
          "coverage": {
            "type": "object",
            "required": ["complete", "files_discovered", "files_scanned", "files_skipped", "bytes_scanned"],
            "properties": {
              "complete": {"type": "boolean"},
              "files_discovered": {"type": "integer", "minimum": 0},
              "files_scanned": {"type": "integer", "minimum": 0},
              "files_skipped": {"type": "integer", "minimum": 0},
              "bytes_scanned": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
