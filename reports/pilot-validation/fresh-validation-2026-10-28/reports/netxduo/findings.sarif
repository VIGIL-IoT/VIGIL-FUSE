                "validationStatus": "not-validated",
                "category": "ci-workflow-security",
                "version": "1.0.0"
              },
              "helpUri": "https://docs.github.com/en/actions/security-for-github-actions/security-guides/security-hardening-for-github-actions#using-third-party-actions"
            },
            {
              "id": "FUSE001",
              "shortDescription": {
                "text": "Credential-like literal assigned in source"
              },
              "fullDescription": {
                "text": "A credential-related name is assigned a literal value. Quoted assignments are checked in source/configuration, and plain values are also checked in .env files. FUSE cannot determine whether the value is valid or used."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "severity": "medium",
                "severityBasis": "rule",
