{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "worker",
    "status",
    "artifacts",
    "findings",
    "evidence",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "analyzer"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "analyzer": {
          "const": "probe"
        }
      }
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "blocked",
        "timeout"
      ]
    },
    "artifacts": {
      "const": []
    },
    "findings": {
      "const": []
    },
    "evidence": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target"
        ],
        "properties": {
          "kind": {
            "const": "target-identity"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "sha256"
            ],
            "properties": {
              "target_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "const": {}
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
