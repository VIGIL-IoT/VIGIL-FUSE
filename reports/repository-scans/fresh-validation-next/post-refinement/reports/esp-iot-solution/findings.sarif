      "tool": {
        "driver": {
          "name": "FUSE",
          "semanticVersion": "0.2.0",
          "rules": [
            {
              "id": "FUSE006",
              "shortDescription": {
                "text": "ESP-IDF bootloader image validation is disabled"
              },
              "fullDescription": {
                "text": "A scanned Kconfig-style input or selected generated configuration explicitly enables CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS. ESP-IDF documents that this prevents the bootloader from validating the app image before booting it. This finding does not establish that the file is the active build configuration or that a built image is deployed."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "severity": "medium",
                "severityBasis": "rule",
                "severityScore": null,
                "severityVector": null,
                "severityVersion": null,
                "confidence": "high",
                "applicability": "candidate",
                "validationMethod": "static",
                "validationStatus": "not-validated",
                "category": "boot-integrity",
                "version": "1.2.0"
              },
              "helpUri": "https://docs.espressif.com/projects/esp-idf/en/stable/esp32/api-reference/kconfig-reference.html"
            },
            {
              "id": "FUSE002",
              "shortDescription": {
                "text": "Private key PEM marker embedded in scanned file"
              },
              "fullDescription": {
                "text": "A PEM private-key boundary marker is present. FUSE detects the marker but does not validate the key or determine whether the file is deployed."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "high",
                "severityBasis": "rule",
                "severityScore": null,
                "severityVector": null,
                "severityVersion": null,
                "confidence": "high",
                "applicability": "unknown",
                "validationMethod": "static",
                "validationStatus": "not-validated",
                "category": "secrets",
                "version": "1.1.0"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/321.html"
            },
            {
              "id": "FUSE007",
              "shortDescription": {
                "text": "ESP-IDF skips app-image validation after deep sleep"
              },
              "fullDescription": {
                "text": "A scanned Kconfig-style input or selected generated configuration explicitly enables CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP. Espressif documents that this skips normal image checks, including checksum, SHA-256, and signature validation, when resuming from deep sleep. If the active OTA partition is changed before that resume, the new image may skip its first validation. This finding does not prove that the file is active or that the device follows that OTA/deep-sleep path."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "severity": "medium",
                "severityBasis": "rule",
                "severityScore": null,
                "severityVector": null,
                "severityVersion": null,
                "confidence": "high",
                "applicability": "candidate",
                "validationMethod": "static",
                "validationStatus": "not-validated",
                "category": "boot-integrity",
                "version": "1.2.0"
              },
              "helpUri": "https://docs.espressif.com/projects/esp-idf/en/stable/esp32/api-reference/kconfig-reference.html"
            },
            {
              "id": "FUSE001",
              "shortDescription": {
                "text": "Credential-like literal assigned in source"
              },
              "fullDescription": {
                "text": "A credential-related name is assigned a literal value. Quoted assignments are checked in source/configuration, and plain values are also checked in .env files. FUSE cannot determine whether the value is valid or used."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
