              "shortDescription": {
                "text": "GitHub Action reference points to a floating branch"
              },
              "fullDescription": {
                "text": "The workflow selects an action by a branch-like reference that can move without a workflow change. Other non-SHA version references are counted in inventory but are not findings in this conservative check."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "severity": "info",
                "severityBasis": "rule",
                "severityScore": null,
