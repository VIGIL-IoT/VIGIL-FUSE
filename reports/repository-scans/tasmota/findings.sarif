              "shortDescription": {
                "text": "Non-loopback HTTP endpoint configured"
              },
              "fullDescription": {
                "text": "A non-loopback URL explicitly uses HTTP. This indicates an unencrypted endpoint in source or configuration, but does not prove the endpoint is reachable or used."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "severity": "medium",
                "confidence": "high",
                "category": "transport-security",
                "version": "1.0.0"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/319.html"
            },
            {
              "id": "FUSE001",
              "shortDescription": {
                "text": "Credential-like literal assigned in source"
              },
              "fullDescription": {
                "text": "A credential-related name is assigned a literal value. Quoted assignments are checked in source/configuration, and plain values are also checked in .env files. FUSE cannot determine whether the value is valid or used."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "severity": "medium",
                "confidence": "high",
                "category": "secrets",
                "version": "1.0.0"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html"
            },
            {
              "id": "FUSE003",
              "shortDescription": {
                "text": "TLS peer verification appears disabled"
              },
              "fullDescription": {
                "text": "The source contains an explicit setting or API commonly used to bypass TLS certificate or hostname verification. FUSE does not establish that this path runs."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "high",
                "confidence": "high",
                "category": "transport-security",
                "version": "1.0.0"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/295.html"
            }
          ]
        }
